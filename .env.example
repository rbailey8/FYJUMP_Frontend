# All values are read by the server at request time. In production they come
# from "vars" in wrangler.jsonc.

# The FYJUMP API the server calls.
API_BASE_URL=https://api.fyjump.com

# Public URL of this site (canonical URLs, sitemap, robots.txt).
# Defaults to https://hiring.fyjump.com when unset.
SITE_URL=http://localhost:3000

# "true" lets search engines index the site; anything else serves noindex
# and a robots.txt that blocks all crawlers.
ALLOW_INDEXING=false
